# ========================================================================
# LISTA COMPARS - VARIABLES DE ENTORNO (.env.example)
# Copiá este archivo a .env y completá con tus claves reales.
# Si dejás los valores por defecto o vacíos, la app funciona en MODO DEMO / SIMULADO.
# ========================================================================

# --- SUPABASE (Frontend & Cliente) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# --- SUPABASE (Solo Servidor / Edge Functions) ---
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada-aqui

# --- GEMINI IA (Solo Servidor / Edge Functions) ---
GEMINI_API_KEY=tu-gemini-api-key-aqui
# Modelo por defecto de la familia Gemini (rápido y económico, sin fijar en código)
GEMINI_MODEL=gemini-2.5-flash

# --- MERCADO PAGO (Solo Servidor / Edge Functions) ---
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-access-token-de-mercadopago-aqui
MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key-aqui

# --- WEB PUSH NOTIFICATIONS (VAPID) ---
VITE_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-tu-clave-publica-vapid
VAPID_PRIVATE_KEY=tu-clave-privada-vapid-aqui
VAPID_SUBJECT=mailto:soporte@listacompars.ar

# --- MONEDA Y COTIZACIÓN ---
# Cotización de referencia USD a ARS para el pago de la licencia
ARS_USD_RATE=1350
